# ship:begin (owned by ship init; repo-specific lines go below the end marker)
# Allowlist: the images build from the dirs below only. A new root-level file stays out of the context without anyone
# having to remember this list. BuildKit reads the -f Containerfile outside these rules.
*
!backend
!ui
# The host's node_modules (darwin native binaries) would land on top of the image's own install; the image builds
# dist itself.
ui/node_modules
ui/dist
ui/coverage
# ship:end

ui/tsconfig.tsbuildinfo
*.png
# A stale local `make fe-build` leaves hashed assets in backend/web/dist.
# Stage 2's `COPY backend/ ./` would pull those into the image, and the
# later `COPY --from=ui ...` only overlays on top of them rather than
# replacing them, so old files could survive in the embedded filesystem.
# Excluding it here forces the image to serve only what the ui stage just
# built.
backend/web/dist
