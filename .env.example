# rongo runtime configuration. Copy to .env and fill in.
# Every setting is BACKEND_*. Secrets live here only, never in repos.yaml.
#
# The active lines below are the ones a deployment has to fill in: the process
# has no default for them and refuses to start without one. Everything
# commented out is optional and the value after the "#" is the default the
# process uses when the variable is absent — except in the OIDC block, where
# the values are examples and the loader has no default at all.

# =====================================================================
# Required
# =====================================================================

# --- Auth ---
# Reserved, not yet consumed by anything (sessions are unsalted SHA-256 of a
# random token) — still required so a later phase adding cookie signing
# doesn't inherit a placeholder. Must be at least 16 characters and not the
# literal "change-me". Generate one with: openssl rand -base64 32
BACKEND_SESSION_SECRET=

# --- Embeddings ---
# An OpenAI-compatible /embeddings endpoint. Required while indexing is on; to
# run the UI without it set BACKEND_INDEX_ENABLED=false.
BACKEND_EMBED_BASE_URL=https://api.openai.com/v1

# =====================================================================
# Required only with BACKEND_AUTH_MODE=oidc
# =====================================================================

# All four are mandatory in oidc mode; a missing one stops the process instead
# of failing every login later. Discovery runs at startup, so a wrong issuer
# stops it too. For Authelia the issuer is the bare origin: no path, no
# trailing slash.
#BACKEND_OIDC_ISSUER=https://auth.example.com
#BACKEND_OIDC_CLIENT_ID=rongo
#BACKEND_OIDC_CLIENT_SECRET=
#BACKEND_OIDC_REDIRECT_URL=https://rongo.example.com/api/auth/callback
# The group whose members are admins. Empty means no group check: everyone the
# provider let through is an admin, which is the truthful default while the only
# real gate is the provider's own authorization policy.
#BACKEND_OIDC_ADMIN_GROUP=

# =====================================================================
# Optional — the value shown is the default
# =====================================================================

# --- HTTP ---
# The listen address has to match the auth mode: "dev" auto-logs in an admin
# without credentials and refuses to start on anything but loopback.
#BACKEND_ADDR=127.0.0.1:8080
# The externally reachable base URL. With BACKEND_AUTH_MODE=oidc it must be
# https://, because the session and nonce cookies take their Secure flag from
# it and nothing else can see the TLS a terminating proxy handled.
#BACKEND_PUBLIC_URL=http://127.0.0.1:8080
#BACKEND_LOG_LEVEL=info

# --- Storage ---
# Relative paths resolve against the repo root, for `make dev` as well as for
# compose, which mounts ./data and ./repos there.
#BACKEND_DB_PATH=./data/rongo.db
#BACKEND_REPO_ROOT=./repos

# --- Auth ---
# dev  : auto-login as admin, loopback addresses only
# token: every request needs BACKEND_ADMIN_TOKEN as a bearer token
# oidc : production — the browser signs in at the provider
#BACKEND_AUTH_MODE=dev
# Required when BACKEND_AUTH_MODE=token, ignored otherwise. No default.
#BACKEND_ADMIN_TOKEN=

# --- Model ---
# The MiMo endpoint, OpenAI-compatible chat completions. The two deployment
# NAMES are hardcoded in internal/llm and deliberately not settings: a
# deployment name in the environment lets a misconfigured host answer with a
# model nobody chose. Leaving the URL empty still serves the Repos page and
# keeps indexing; the question routes then answer 503.
#BACKEND_LLM_BASE_URL=
#BACKEND_LLM_API_KEY=

# --- Forge tokens ---
# For private repositories, one per forge host, named by token_env in
# repos.yaml. Never put the value in repos.yaml itself. The variable name is
# whatever the YAML declares; this is the usual one.
#BACKEND_FORGE_TOKEN_GITHUB=

# --- Indexing ---
# Path to the repository list. Its entries carry no secrets: each names the
# environment variable holding its forge token via token_env, and the value
# lives here or in the process environment, never in the YAML.
#BACKEND_REPOS_FILE=./repos.yaml
# Set to false to run the UI without indexing anything. While it is true an
# embedding endpoint is mandatory, because an indexer that cannot embed leaves
# a repository list that looks configured and an index that stays empty.
#BACKEND_INDEX_ENABLED=true
# Files larger than this are skipped whole rather than truncated: half a file
# produces confidently wrong answers about the other half. 1 MiB by default.
#BACKEND_INDEX_MAX_FILE_BYTES=1048576
# Keeps whole-line comments in the text that is embedded and full-text indexed.
# Turning it off changes every chunk's content hash and therefore costs a full
# re-embed of the corpus; the stored source is untouched either way.
#BACKEND_INDEX_COMMENTS=true

# --- Retrieval tuning ---
# The module cut: below the minimum a directory is folded into its parent,
# above the maximum it is split again.
#BACKEND_MODULE_MIN_CHUNKS=8
#BACKEND_MODULE_MAX_CHUNKS=150
# How far the leading candidate must be ahead before a turn answers instead of
# asking back. See docs/measurements/2026-08-18-routing.md before changing it.
#BACKEND_ROUTE_MARGIN=0.25
# Bounds on the reference walk. Without them one question walks the corpus.
#BACKEND_GATHER_MAX_HOPS=2
#BACKEND_GATHER_TOKEN_BUDGET=24000

# --- Embeddings ---
# Sent as the bearer token to BACKEND_EMBED_BASE_URL. Empty is legitimate for a
# local endpoint that authenticates nobody; against OpenAI it is mandatory and
# the endpoint answers 401 without it. The key is a secret and belongs here,
# never in repos.yaml, and it is never logged.
#BACKEND_EMBED_API_KEY=
#BACKEND_EMBED_MODEL=text-embedding-3-small
# The vector width, baked into the vec0 table when the database is created:
# 1536 for text-embedding-3-small, 3072 for -large. Changing it means a NEW
# database file — the process refuses to start against one built for the other.
#BACKEND_EMBED_DIM=1536
