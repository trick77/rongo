# rongo runtime configuration. Copy to .env and fill in.
# Active line = mandatory, no default. "#" = optional, the value shown is the
# default. Secrets live here only, never in repos.yaml.

# --- Session ---
# At least 16 characters, not "change-me": openssl rand -base64 32
BACKEND_SESSION_SECRET=

# --- Model: answers questions ---
# OpenAI-compatible chat completions. The deployment names are hardcoded in
# internal/llm, on purpose, and the host is llmwire's: its profile carries
# MiMo's token-plan endpoint, so only the key is configured and the host
# cannot be overridden under compose. The variable
# name is llmwire's, LLMWIRE_<PROVIDER>_API_KEY for the provider each model's
# profile names, so one .env serves every app on llmwire.
LLMWIRE_MIMO_API_KEY=
# Present every model call as the opencode client: its User-Agent and session
# headers. The MiMo token-plan host is marked for it in llmwire's profile
# already; set this for a host that is not marked but wants it. It only adds
# the identity. Read by llmwire, not by rongo.
# LLMWIRE_EMULATE_OPENCODE=true

# --- Embeddings: builds the index ---
# OpenAI-compatible /embeddings. Mandatory: every answer embeds the question,
# whether indexing is on or not. The host is OpenAI's, carried by llmwire's
# profile; only the key is configured.
LLMWIRE_OPENAI_API_KEY=
# The model is not a setting: embed.Model (text-embedding-3-small), with its
# width from the llmwire profile, baked into the vec0 table at creation. A
# different model is a different build and a NEW database file.

# --- Auth ---
# dev     : auto-login as admin, loopback only
# token   : bearer BACKEND_ADMIN_TOKEN on every request, API only
# password: one admin account, login form in the UI
# oidc    : production
#BACKEND_AUTH_MODE=dev
#BACKEND_ADMIN_TOKEN=
# Both mandatory with password. The hash is bcrypt, never the plaintext:
# `echo -n 'the password' | rongo -hash-password`. The session cookie is
# Secure unless BACKEND_COOKIE_SECURE=false, which only a loopback listener
# may set.
#BACKEND_ADMIN_USER=admin
#BACKEND_ADMIN_PASSWORD_HASH=
#BACKEND_COOKIE_SECURE=true
# All four mandatory with oidc. The issuer is the bare origin: no path, no
# trailing slash. The redirect URL must be https:// — the session cookie's
# Secure flag comes from it, since behind a TLS-terminating proxy the process
# only ever sees plain HTTP. Values below are examples, not defaults.
#BACKEND_OIDC_ISSUER=https://auth.example.com
#BACKEND_OIDC_CLIENT_ID=rongo
#BACKEND_OIDC_CLIENT_SECRET=
#BACKEND_OIDC_REDIRECT_URL=https://rongo.example.com/api/auth/callback
# Empty means no group check: every user the provider lets through is admin.
#BACKEND_OIDC_ADMIN_GROUP=

# --- HTTP ---
# dev auth mode refuses anything but loopback.
#BACKEND_ADDR=127.0.0.1:8080
#BACKEND_LOG_LEVEL=info

# --- Storage ---
# Relative paths resolve against the repo root.
#BACKEND_DB_PATH=./data/rongo.db
#BACKEND_REPO_ROOT=./repos

# --- Indexing ---
#BACKEND_REPOS_FILE=./repos.yaml
# Forge token for private repositories, one per host, named by token_env in
# repos.yaml. The value never goes in the YAML.
#BACKEND_FORGE_TOKEN_GITHUB=
# false serves the UI without indexing anything.
#BACKEND_INDEX_ENABLED=true
# Larger files are skipped whole, not truncated.
#BACKEND_INDEX_MAX_FILE_BYTES=1048576
# Turning it off changes every chunk hash: costs a full re-embed.
#BACKEND_INDEX_COMMENTS=true
# Repo-relative globs, comma-separated, ** spans directories, anchored at the
# root. Matches are recorded as skipped, never embedded; already-indexed
# matches are swept at the next start; removing a pattern takes effect for a
# file when it next changes. "none" excludes nothing.
#BACKEND_INDEX_EXCLUDE=docs/plans/**

# --- Retrieval tuning ---
# The module cut: below the minimum a directory folds into its parent, above
# the maximum it splits again.
#BACKEND_MODULE_MIN_CHUNKS=8
#BACKEND_MODULE_MAX_CHUNKS=150
# How far the leading candidate must lead before a turn answers instead of
# asking back.
#
# INERT on the current corpus: the sweep is flat at 47/65 across the whole
# useful range, 0.10 to 0.40, and the margin rung settles no decision either
# way (docs/measurements/2026-09-06-routing-rerun.md). The rungs above it —
# a named repository, a manifest edge, the repository card — reach the answer
# first. Tuning this expecting movement is wasted time; the rung to look at is
# the repository one. It stays configurable because a corpus with different
# score distributions can put decisions back on this rung.
#BACKEND_ROUTE_MARGIN=0.25
# Bounds on the reference walk. Without them one question walks the corpus.
#BACKEND_GATHER_MAX_HOPS=2
#BACKEND_GATHER_TOKEN_BUDGET=24000
# The most one turn may spend across all of its model and embedding calls,
# prompt and completion. A tripwire, not a budget: a turn measures 24-37k, the
# heaviest on record 83k. Checked before each call, never mid-answer. 0 = off.
#BACKEND_TURN_MAX_TOKENS=250000
