# rongo runtime configuration. Copy to .env and fill in.
# Every setting is BACKEND_*. Secrets live here only, never in repos.yaml.

# --- HTTP ---
BACKEND_ADDR=127.0.0.1:8080
BACKEND_PUBLIC_URL=http://127.0.0.1:8080
BACKEND_LOG_LEVEL=info

# --- Storage ---
BACKEND_DB_PATH=./data/rongo.db
BACKEND_REPO_ROOT=./repos

# --- Auth ---
# dev  : auto-login as admin, loopback addresses only
# token: every request needs BACKEND_ADMIN_TOKEN as a bearer token
# oidc : production (implemented in a later phase)
BACKEND_AUTH_MODE=dev
BACKEND_ADMIN_TOKEN=
# Reserved, not yet consumed by anything (sessions are unsalted SHA-256 of a
# random token) — still required so a later phase adding cookie signing
# doesn't inherit a placeholder. Must be at least 16 characters and not the
# literal "change-me". Generate one with: openssl rand -base64 32
BACKEND_SESSION_SECRET=

# --- Indexing ---
# Path to the repository list. Its entries carry no secrets: each names the
# environment variable holding its forge token via token_env, and the value
# lives here or in the process environment, never in the YAML.
BACKEND_REPOS_FILE=./repos.yaml
# Files larger than this are skipped whole rather than truncated: half a file
# produces confidently wrong answers about the other half. 1 MiB by default.
BACKEND_INDEX_MAX_FILE_BYTES=1048576
# Set to false to run the UI without indexing anything. While it is true an
# embedding endpoint is mandatory, because an indexer that cannot embed leaves
# a repository list that looks configured and an index that stays empty.
BACKEND_INDEX_ENABLED=true

# --- Embeddings ---
# An OpenAI-compatible /embeddings endpoint. The key is a secret and belongs
# here, never in repos.yaml, and it is never logged.
BACKEND_EMBED_BASE_URL=https://api.openai.com/v1
BACKEND_EMBED_API_KEY=
BACKEND_EMBED_MODEL=text-embedding-3-small
# The vector width, baked into the vec0 table when the database is created:
# 1536 for text-embedding-3-small, 3072 for -large. Changing it means a NEW
# database file — the process refuses to start against one built for the other.
BACKEND_EMBED_DIM=1536
